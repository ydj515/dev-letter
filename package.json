{
  "name": "dev-letter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run lint:svg && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:svg": "svglint \"public/**/*.svg\"",
    "analyze:subs": "node scripts/analyze-subscribers.mjs",
    "seed:newsletter": "node scripts/seed-newsletter.mjs",
    "test:newsletter": "tsc -p tsconfig.test.json && node --test \".tmp/tests/tests/*.test.js\"",
    "cron:send": "tsx scripts/cron-send.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.10",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "next": "^16.4.6",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "minimatch@>=7.0.0 <11.0.8": "^11.0.8",
    "glob@>=9.0.0 <14.0.6": "^14.0.6",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@react-email/render": "$@react-email/render"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "svglint": "^4.2.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
